# Copia este archivo a terraform.tfvars (gitignorado) y completa los valores
# reales. Nunca subas terraform.tfvars al repo — tiene contraseñas y tokens.

location                = "westus"
resource_group_name     = "DEVOPS"
postgres_server_name    = "devops1274"
postgres_admin_user     = "apiadmin"
postgres_admin_password = "CAMBIA_ESTO_POR_UNA_PASSWORD_REAL"

servicebus_queue_name         = "tareas-orquestador"
servicebus_max_delivery_count = 3

# Token de GitHub con scope read:packages, para que Container Apps pueda
# hacer pull de las imágenes privadas de ghcr.io.
ghcr_username = "BETO1274"
ghcr_token    = "CAMBIA_ESTO_POR_UN_TOKEN_CON_read:packages"

# La key compartida que ya usan el gateway y el orquestador.
team_api_key = "CAMBIA_ESTO_POR_LA_KEY_REAL"
