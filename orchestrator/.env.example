NODE_ENV=development
PORT=3100
# Postgres local del docker-compose (o el de Azure). Si se deja vacía, el estado
# de las tareas queda solo en memoria y NO se comparte con el worker.
# Local: postgresql://orquestador:orquestador_dev@localhost:5433/orquestador
DATABASE_URL=
# Emulador local: Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE_NAME=tareas-orquestador
# Debe coincidir con MaxDeliveryCount en emulator-config.json (o el valor real en Azure)
SERVICEBUS_MAX_DELIVERY_COUNT=3

# URLs de las 3 APIs del equipo, para que el worker despache de verdad
API_FASTIFY_URL=http://localhost:3000
DEPORTBACK_URL=
INVENTARIO_U_URL=
# Key compartida con el equipo (ver credentials.local.md en la raíz del repo)
TEAM_API_KEY=
