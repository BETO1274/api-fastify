# URL base de cada servicio de Render (sin barra final)
STABLE_URL=https://api-fastify-stable.onrender.com
CANARY_URL=https://api-fastify-canary.onrender.com

# Porcentaje inicial de trafico publico hacia canary (0-100). 0 = etapa 0
CANARY_WEIGHT=0

# Clave para cambiar el porcentaje en caliente (POST /admin/weight)
ADMIN_KEY=cambiar-por-una-clave-larga

PORT=8080
