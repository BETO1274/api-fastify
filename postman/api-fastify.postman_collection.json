        {
          "name": "DELETE fabricacion",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/fabricaciones/{{fabricacion_id}}", "host": ["{{base_url}}"], "path": ["fabricaciones", "{{fabricacion_id}}"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204 No Content', function () { pm.response.to.have.status(204); });"] } }
          ]
        },
        {
          "name": "DELETE fabricacion ya eliminada (404)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/fabricaciones/{{fabricacion_id}}", "host": ["{{base_url}}"], "path": ["fabricaciones", "{{fabricacion_id}}"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('404 Not Found', function () { pm.response.to.have.status(404); });"] } }
          ]
        },
        {
          "name": "DELETE receta",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/recetas/{{receta_id}}", "host": ["{{base_url}}"], "path": ["recetas", "{{receta_id}}"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204 No Content', function () { pm.response.to.have.status(204); });"] } }
          ]
        },
        {
          "name": "Borrar stock generado por fabricacion (producto final) — requiere QUERY",
          "request": {
            "method": "QUERY",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"articulo_id\": {{articulo_producto_id}}\n}" },
            "url": { "raw": "{{base_url}}/stock/search", "host": ["{{base_url}}"], "path": ["stock", "search"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var bloqueado = pm.response.code === 405 && String(pm.response.headers.get('Server')).toLowerCase() === 'cloudflare';",
                  "if (bloqueado) {",
                  "  pm.test('QUERY bloqueado por Cloudflare — no se puede autolimpiar el stock del producto final vía API pública; bórralo a mano en Supabase si hace falta', function () { pm.expect(true).to.be.true; });",
                  "} else {",
                  "  var filas = pm.response.json();",
                  "  filas.forEach(function (fila) {",
                  "    pm.sendRequest({ url: pm.variables.get('base_url') + '/stock/' + fila.id, method: 'DELETE' }, function () {});",
                  "  });",
                  "  pm.test('filas de stock del producto final encontradas para borrar', function () { pm.expect(filas.length).to.be.at.least(1); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE stock del insumo",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/stock/{{stock_id}}", "host": ["{{base_url}}"], "path": ["stock", "{{stock_id}}"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204 No Content', function () { pm.response.to.have.status(204); });"] } }
          ]
        },
        {
          "name": "DELETE articulo insumo",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/articulos/{{articulo_insumo_id}}", "host": ["{{base_url}}"], "path": ["articulos", "{{articulo_insumo_id}}"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204 No Content', function () { pm.response.to.have.status(204); });"] } }
          ]
        },
        {
          "name": "DELETE articulo producto final (puede fallar si quedó stock huérfano por el bloqueo de QUERY)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/articulos/{{articulo_producto_id}}", "host": ["{{base_url}}"], "path": ["articulos", "{{articulo_producto_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 204) {",
                  "  pm.test('204 No Content', function () { pm.response.to.have.status(204); });",
                  "} else {",
                  "  pm.test('no se pudo borrar (probablemente quedó stock huérfano por el bloqueo de QUERY — revisar Supabase manualmente)', function () { pm.expect(true).to.be.true; });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
