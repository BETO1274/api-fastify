  "item": [
    {
      "name": "00 - Salud, versiones y metricas",
      "item": [
        {
          "name": "1 - GET health stable",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{stable_url}}/health",
              "host": [
                "{{stable_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"x-track = stable\", function () { pm.expect(pm.response.headers.get(\"x-track\")).to.eql(\"stable\"); });",
                  "pm.test(\"X-App-Version es 3.x\", function () { pm.expect(pm.response.headers.get(\"x-app-version\")).to.match(/^3\\./); });"
                ]
              }
            }
