    {
      "name": "03 - Canary: inyeccion de fallos (requiere team_api_key)",
      "item": [
        {
          "name": "1 - GET estado del caos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{team_api_key}}"
              }
            ],
            "url": {
              "raw": "{{canary_url}}/admin/caos",
              "host": [
                "{{canary_url}}"
              ],
              "path": [
                "admin",
                "caos"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"trae latencia_ms y tasa_error\", function () { var j = pm.response.json(); pm.expect(j).to.have.property(\"latencia_ms\"); pm.expect(j).to.have.property(\"tasa_error\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2 - POST activar caos (100 % de errores 500)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{team_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{canary_url}}/admin/caos",
              "host": [
                "{{canary_url}}"
              ],
              "path": [
                "admin",
                "caos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tasa_error\": 1,\n  \"latencia_ms\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Activa la falla. Acuerdate de apagarla con el request 5."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"caos activo\", function () { pm.expect(pm.response.json().tasa_error).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3 - GET articulos/1 con el caos activo (500 esperado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{canary_url}}/articulos/1",
              "host": [
                "{{canary_url}}"
              ],
              "path": [
