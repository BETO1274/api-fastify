                  "pm.test(\"es el articulo creado\", function () { pm.expect(pm.response.json().nombre).to.eql(\"Prueba Postman\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5 - PATCH update (unidad_medida)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{stable_url}}/articulos/{{articulo_stable_id}}",
              "host": [
                "{{stable_url}}"
              ],
              "path": [
                "articulos",
                "{{articulo_stable_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidad_medida\": \"toneladas\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"se actualizo\", function () { pm.expect(pm.response.json().unidad_medida).to.eql(\"toneladas\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "6 - QUERY search (por tipo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-HTTP-Method-Override",
                "value": "QUERY"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{stable_url}}/articulos/search",
              "host": [
                "{{stable_url}}"
              ],
              "path": [
                "articulos",
                "search"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"materia_prima\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Verbo QUERY enviado como POST + X-HTTP-Method-Override: QUERY."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"devuelve un arreglo con resultados\", function () { var a = pm.response.json(); pm.expect(a).to.be.an(\"array\"); pm.expect(a.length).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "7 - DELETE (borra el creado)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{stable_url}}/articulos/{{articulo_stable_id}}",
              "host": [
                "{{stable_url}}"
              ],
              "path": [
                "articulos",
                "{{articulo_stable_id}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ],
      "description": "La v3 ignora la columna categoria: no la acepta ni la devuelve."
    },
