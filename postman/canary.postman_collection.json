                  "pm.test(\"stable (v3) NO devuelve categoria\", function () { pm.expect(pm.response.json()).to.not.have.property(\"categoria\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3 - POST create (guarda el id)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{stable_url}}/articulos",
              "host": [
                "{{stable_url}}"
              ],
              "path": [
                "articulos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prueba Postman\",\n  \"tipo\": \"materia_prima\",\n  \"unidad_medida\": \"kg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "var a = pm.response.json();",
                  "pm.collectionVariables.set(\"articulo_stable_id\", a.id);",
                  "pm.test(\"se creo con id\", function () { pm.expect(a.id).to.be.a(\"number\"); });",
                  "pm.test(\"stable (v3) NO devuelve categoria\", function () { pm.expect(a).to.not.have.property(\"categoria\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4 - GET by id (el creado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{stable_url}}/articulos/{{articulo_stable_id}}",
              "host": [
                "{{stable_url}}"
              ],
              "path": [
                "articulos",
