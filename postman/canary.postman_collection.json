              ],
              "path": [
                "articulos"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"x-track = stable\", function () { pm.expect(pm.response.headers.get(\"x-track\")).to.eql(\"stable\"); });",
                  "var a = pm.response.json();",
                  "pm.test(\"devuelve un arreglo\", function () { pm.expect(a).to.be.an(\"array\"); });",
                  "pm.test(\"stable (v3) NO devuelve categoria\", function () { pm.expect(a[0]).to.not.have.property(\"categoria\"); });"
